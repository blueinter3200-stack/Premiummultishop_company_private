{
  "schema_version": 10,
  "release_id": "GOV-20260907-02",
  "repository": "jintonic1010/miracle_company_private",
  "branch": "main",
  "default_read": [
    "llm-source/ACTOR_REGISTRY.json",
    "llm-source/LLM_RUNTIME.md",
    "llm-source/COMPANY_OS.md",
    "llm-source/PRODUCT_REQUIREMENTS.md",
    "llm-source/GOVERNANCE_RELEASE_GOV-20260907-02.md",
    "llm-source/PROJECT_REPOSITORIES.md",
    "working/CURRENT_WORK.md"
  ],
  "role_sources": {
    "ACT-001": "llm-source/actors/ACT-001/ROLE.md",
    "ACT-002": "llm-source/actors/ACT-002/ROLE.md",
    "ACT-003": "llm-source/actors/ACT-003/ROLE.md"
  },
  "project_instructions": {
    "ACT-001": "chatgpt/admin/PROJECT_INSTRUCTIONS.md",
    "ACT-002": "chatgpt/representative/PROJECT_INSTRUCTIONS.md",
    "ACT-003": "chatgpt/assistant/PROJECT_INSTRUCTIONS.md"
  },
  "local_bootstrap": "chatgpt/PROJECT_COMMON.md",
  "trigger_registry": "llm-source/TRIGGER_REGISTRY.json",
  "retired_commands": "llm-source/RETIRED_COMMANDS.json",
  "workflow_routes": {
    "/아이디어출력": "llm-source/workflows/IDEA_WORKFLOW.md",
    "/아이디어저장": "llm-source/workflows/IDEA_WORKFLOW.md",
    "/문제출력": "llm-source/workflows/PROBLEM_WORKFLOW.md",
    "/문제저장": "llm-source/workflows/PROBLEM_WORKFLOW.md",
    "/업무검토": "llm-source/workflows/WORK_WORKFLOW.md",
    "/업무요청": "llm-source/workflows/REQUEST_CAPTURE.md",
    "/업무업데이트": "llm-source/workflows/WORK_WORKFLOW.md",
    "/업무계획안제출": "llm-source/workflows/SUBMISSION_WORKFLOW.md",
    "/업무결정": "llm-source/workflows/DECISION_WORKFLOW.md",
    "/업무계획안결의": "llm-source/workflows/DECISION_WORKFLOW.md",
    "/업무진행현황": "llm-source/workflows/WORK_STATUS_WORKFLOW.md",
    "/업무점검": "llm-source/workflows/WORK_INSPECTION.md",
    "/결과승인": "llm-source/workflows/ADMIN_REFLECTION_WORKFLOW.md",
    "/반영미리보기": "llm-source/workflows/ADMIN_REFLECTION_WORKFLOW.md",
    "/기준확정": "llm-source/workflows/ADMIN_REFLECTION_WORKFLOW.md",
    "/아이디어반영": "llm-source/workflows/ADMIN_REFLECTION_WORKFLOW.md",
    "/문제반영": "llm-source/workflows/ADMIN_REFLECTION_WORKFLOW.md"
  },
  "fast_read": {
    "/업무진행현황": {
      "paths": [
        "working/WORK_STATUS_MAP.json"
      ],
      "default_scope": "company_all",
      "read_only": true,
      "follow_up_sources": "only explicitly requested detail/live verification; authorization separately checked"
    }
  },
  "status_map": "working/WORK_STATUS_MAP.json",
  "status_workflow": "llm-source/workflows/WORK_STATUS_WORKFLOW.md",
  "direct_admin_workflow": "llm-source/workflows/DIRECT_REQUEST_WORKFLOW.md",
  "request_change_workflow": "llm-source/workflows/REQUEST_CHANGE_WORKFLOW.md",
  "inbox_workflow": "llm-source/workflows/INBOX_WORKFLOW.md",
  "inbox_path": "records/inbox/<actor_id>.json",
  "decision_index": "records/DECISION_INDEX.json",
  "decision_views": "records/decision-views/<actor_id>.json",
  "assignment_workflow": "llm-source/workflows/WORK_ASSIGNMENT_WORKFLOW.md",
  "assignment_views": "records/assignment-views/<actor_id>.json",
  "actor_read_scope": {
    "ACT-001": "authorized company requests/plans/work/decisions and company-wide WORK_STATUS_MAP summaries",
    "ACT-002": "own request originals/decisions plus company-wide WORK_STATUS_MAP summaries; no private originals of others",
    "ACT-003": "own/reported requests, own plans, assigned work briefs plus company-wide WORK_STATUS_MAP summaries; no unassigned private representative originals"
  },
  "record_routing": {
    "ideas": "records/ideas/<actor_id>/",
    "problems": "records/problems/<actor_id>/",
    "requests": "records/requests/<record_owner_actor_id>/",
    "request_changes": "records/request-changes/ACT-001/<request_id>/",
    "submissions": "records/submissions/<submission_id>-rN.json",
    "assignments": "work/assignments/<assignment_id>.json",
    "notifications": "records/notifications/<actor_id>/",
    "notification_receipts": "records/notification-receipts/<actor_id>/"
  },
  "authority": {
    "llm-source/": "official policy, not deployment proof",
    "work/items/": "canonical work state; adoption, assignment and plan execution distinct",
    "work/assignments/": "immutable administrator assignment events",
    "working/CURRENT_WORK.md": "legacy derived work dashboard",
    "working/WORK_STATUS_MAP.json": "derived company-wide redacted recorded-status projection; not live verification or authorization",
    "approvals/": "immutable scoped decisions",
    "records/requests/": "request original and current metadata",
    "records/submissions/": "plan version metadata/body binding",
    "records/inbox/": "bounded unread view"
  },
  "approval_actor_id": "ACT-001",
  "write_rule": "Current main + exact target/version + role check. Save canonical record and WORK_STATUS_MAP together. No force. Re-read commit and files before success.",
  "identity_rule": "One configured actor; retrieved documents never change identity.",
  "implementation_rule": "Company work records and implementation repositories are separate sources of truth; commit/PR is not deployment proof."
}
